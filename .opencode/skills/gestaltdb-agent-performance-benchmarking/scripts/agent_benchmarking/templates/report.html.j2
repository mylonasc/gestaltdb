<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>GestaltDB Agent Benchmark Report</title>
  <style>
    :root { color-scheme: light dark; font-family: Inter, ui-sans-serif, system-ui, sans-serif; }
    body { margin: 2rem; line-height: 1.45; }
    table { border-collapse: collapse; width: 100%; margin: 1rem 0 2rem; }
    th, td { border: 1px solid #9995; padding: 0.45rem 0.55rem; text-align: left; vertical-align: top; }
    th { background: #7772; }
    code { font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }
    .passed { color: #087f23; font-weight: 700; }
    .failed, .error, .timeout, .judge_failed { color: #b00020; font-weight: 700; }
    .muted { color: #777; }
    details { margin: 0.75rem 0; }
    pre { overflow-x: auto; background: #7771; padding: 0.75rem; }
    .trace-event { border: 1px solid #9995; border-radius: 0.5rem; padding: 0.7rem; margin: 0.75rem 0; }
    .trace-meta { display: flex; flex-wrap: wrap; gap: 0.8rem; color: #777; font-size: 0.9rem; }
    .trace-tool { border-left: 0.3rem solid #4f46e5; }
    .trace-text { border-left: 0.3rem solid #0891b2; }
    .trace-error { border-left: 0.3rem solid #b00020; }
    .trace-grid { display: grid; gap: 0.75rem; grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr)); }
    .raw-json summary { cursor: pointer; }
  </style>
</head>
<body>
  <h1>GestaltDB Agent Benchmark Report</h1>
  <p class="muted">Total runs: {{ summary.total_runs }}. Passed: {{ summary.passed_runs }}. Failed: {{ summary.failed_runs }}.</p>
  {% if summary.sqlite_db_path %}<p>SQLite index: <code>{{ summary.sqlite_db_path }}</code></p>{% endif %}

  <h2>Summary By Benchmark</h2>
  <table>
    <thead>
      <tr><th>Benchmark</th><th>Runs</th><th>Passed</th><th>Failed</th><th>Mean Seconds</th><th>Mean Tokens</th></tr>
    </thead>
    <tbody>
    {% for benchmark_id, item in summary.by_benchmark.items() %}
      <tr>
        <td><code>{{ benchmark_id }}</code></td>
        <td>{{ item.runs }}</td>
        <td>{{ item.passed }}</td>
        <td>{{ item.failed }}</td>
        <td>{{ "%.2f"|format(item.wall_seconds_mean) if item.wall_seconds_mean is not none else "" }}</td>
        <td>{{ "%.0f"|format(item.tokens_total_mean) if item.tokens_total_mean is not none else "" }}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>

  <h2>Runs</h2>
  <table>
    <thead>
      <tr>
        <th>Run</th><th>Started</th><th>Benchmark</th><th>Status</th><th>Model</th><th>Judge</th><th>Seconds</th><th>Tokens</th><th>Context</th><th>Tools</th><th>Trace Analysis</th><th>Artifacts</th>
      </tr>
    </thead>
    <tbody>
    {% for result in results %}
      <tr>
        <td><code>{{ result.run_id }}</code></td>
        <td>{{ result.run_started_at }}</td>
        <td>{{ result.benchmark_name }}</td>
        <td class="{{ result.status }}">{{ result.status }}</td>
        <td><code>{{ result.model }}</code></td>
        <td>{{ result.judge.status }}{% if result.judge.score is not none %} ({{ result.judge.score }}/{{ result.judge.max_score }}){% endif %}</td>
        <td>{{ "%.2f"|format(result.wall_seconds) if result.wall_seconds is not none else "" }}</td>
        <td>{{ result.tokens_total if result.tokens_total is not none else "" }}</td>
        <td>{% if result.model_context_configured %}configured {{ result.model_context_configured }}{% endif %}{% if result.model_context_available %}<br>available {{ result.model_context_available }}{% endif %}</td>
        <td>{{ result.tool_call_count }} {{ result.tool_call_counts }}</td>
        <td>{{ result.analysis.summary }}</td>
        <td>
          {% if result.patch_path %}<div>patch: <code>{{ result.patch_path }}</code></div>{% endif %}
          {% if result.events_path %}<div>events: <code>{{ result.events_path }}</code></div>{% endif %}
          {% if result.session_export_path %}<div>session: <code>{{ result.session_export_path }}</code></div>{% endif %}
          {% if result.trace_path %}<div>trace: <code>{{ result.trace_path }}</code></div>{% endif %}
        </td>
      </tr>
    {% endfor %}
    </tbody>
  </table>

  <h2>Remediation Actions</h2>
  {% if summary.remediation_actions %}
  <ul>
    {% for action in summary.remediation_actions %}
    <li>{{ action }}</li>
    {% endfor %}
  </ul>
  {% else %}
  <p class="muted">No remediation actions were detected by the trace analyzer.</p>
  {% endif %}

  <h2>Run Details</h2>
  {% for result in results %}
  <details>
    <summary><code>{{ result.run_id }}</code> - {{ result.status }}</summary>
    <p>Started: {{ result.run_started_at }}. Finished: {{ result.run_finished_at }}.</p>
    <p>Commit: <code>{{ result.repo_commit_hash }}</code>. Dirty: {{ result.repo_dirty }}. Skill version: {{ result.benchmark_skill_version }}.</p>
    <p>Validation: {{ result.validation.status }} <code>{{ result.validation.command }}</code></p>
    <p>Judge reasoning: {{ result.judge.reasoning }}</p>
    <p>Trace analysis: {{ result.analysis.summary }}</p>
    {% if result.analysis.library_misuse_signals %}<p>Library misuse signals: {{ result.analysis.library_misuse_signals }}</p>{% endif %}
    {% if result.analysis.invalid_code_signals %}<p>Invalid code signals: {{ result.analysis.invalid_code_signals }}</p>{% endif %}
    {% if result.analysis.remediation_actions %}<p>Remediation actions: {{ result.analysis.remediation_actions }}</p>{% endif %}
    {% if result.error %}<pre>{{ result.error }}</pre>{% endif %}
    <pre>{{ result.tool_call_trace }}</pre>
  </details>
  {% endfor %}

  <h2>Trace Viewer</h2>
  <p class="muted">Each event is parsed from the run's <code>opencode-events.jsonl</code>. Tool outputs and raw JSON are truncated in the page for readability; full artifacts remain linked above.</p>
  {% for result in results %}
  {% set trace = trace_views[result.run_id] %}
  <details>
    <summary><code>{{ result.run_id }}</code> trace - {{ trace.events|length }} event(s)</summary>
    <p class="muted">Context: configured {{ trace.context_configured if trace.context_configured is not none else "unknown" }}; advertised {{ trace.context_available if trace.context_available is not none else "unknown" }}.</p>
    {% if trace.raw_error %}<p class="failed">Trace parse warning: {{ trace.raw_error }}</p>{% endif %}
    {% if not trace.events %}
    <p class="muted">No trace events found.</p>
    {% endif %}
    {% for event in trace.events %}
    <section class="trace-event {% if event.tool %}trace-tool{% elif event.text %}trace-text{% else %}trace-error{% endif %}">
      <div class="trace-meta">
        <span>#{{ event.index }}</span>
        <span>{{ event.timestamp }}</span>
        <span><code>{{ event.title }}</code></span>
        {% if event.status %}<span>status: <code>{{ event.status }}</code></span>{% endif %}
        <span>context configured: <code>{{ event.context_configured if event.context_configured is not none else "unknown" }}</code></span>
        <span>context advertised: <code>{{ event.context_available if event.context_available is not none else "unknown" }}</code></span>
        <span>context used: <code>{{ event.context_used if event.context_used is not none else "unknown" }}</code></span>
        {% if event.event_tokens is not none %}<span>event tokens: <code>{{ event.event_tokens }}</code></span>{% endif %}
      </div>
      {% if event.text %}
      <h4>Text</h4>
      <pre>{{ event.text }}</pre>
      {% endif %}
      <div class="trace-grid">
        {% if event.input %}
        <div>
          <h4>Tool Input</h4>
          <pre>{{ event.input }}</pre>
        </div>
        {% endif %}
        {% if event.output %}
        <div>
          <h4>Tool Output</h4>
          <pre>{{ event.output }}</pre>
        </div>
        {% endif %}
      </div>
      <details class="raw-json">
        <summary>Raw JSON</summary>
        <pre>{{ event.raw }}</pre>
      </details>
    </section>
    {% endfor %}
  </details>
  {% endfor %}
</body>
</html>
