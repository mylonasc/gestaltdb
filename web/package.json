{
  "name": "gestaltdb-viz",
  "version": "0.1.0",
  "private": true,
  "description": "D3.js + React front end for GestaltDB packaged graph visualization (build-time only; prebuilt bundles ship with the Python package).",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:licenses -- --lockfile && tsc --noEmit && vite build && npm run manifest",
    "check:bundle": "node scripts/check_bundle.mjs",
    "manifest": "node scripts/write_manifest.mjs",
    "preview": "vite preview",
    "test": "playwright test",
    "check:licenses": "python3 scripts/check_licenses.py"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/d3": "^7.4.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "~5.6.2",
    "vite": "^6.0.3"
  }
}
