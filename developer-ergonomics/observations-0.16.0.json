    "create": "Create a self-describing graph store and return an open handle.",
    "open": "Open a self-describing graph store from a directory.",
    "get_node": "Return a node by byte key.\n\nArgs:\n    node_id: Node ID bytes as stored in the backend.\n\nReturns:\n    The decoded node, or ``None`` when absent.\n\nExamples:\n    >>> graph_db.get_node(b\"drug-1\")  # doctest: +SKIP",
    "get_nodes": "Return decoded nodes in request order (``None`` for missing IDs).",
    "index_statistics": "Return persisted index definitions visible to the query planner.",
    "get_node_keys_generator": "Yield node keys from the backing store.\n\nArgs:\n    num_nodes: Optional maximum number of keys to yield.\n    key_offset: Optional starting key.\n\nReturns:\n    Generator of node key bytes.\n\nExamples:\n    >>> list(graph_db.get_node_keys_generator(num_nodes=10))  # doctest: +SKIP",
    "iter_edge_ids": "Yield all canonical edge IDs from the backing store.\n\nArgs:\n    num_edges: Optional maximum number of edge IDs to yield.\n    key_offset: Optional starting key.\n\nYields:\n    Edge ID bytes in backend key order.\n\nExamples:\n    >>> list(graph_db.iter_edge_ids())  # doctest: +SKIP\n    [b'd1-p1']",
